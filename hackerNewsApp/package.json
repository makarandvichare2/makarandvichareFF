{
  "name": "hacker-news-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-http-server not working": "ng build --configuration=production && cd dist/hacker-news-app/browser && http-server -c-1",
    "lighthouse-server working": "serve --single dist/hacker-news-app/browser -l 8080",
    "lighthouse-cli working": "lighthouse http://127.0.0.1:8080 --output html --output-path ./lighthouse-report.html",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "e2e": "start-server-and-test start http://localhost:4200 cy:open",
    "storybook": "ng run hackerNewsApp:storybook",
    "build-storybook": "ng run hackerNewsApp:build-storybook",
    "test:coverage": "jest --coverage",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@fortawesome/angular-fontawesome": "^1.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.0.1",
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@ngrx/effects": "^19.2.0",
    "@ngrx/store": "^19.2.0",
    "@ngrx/store-devtools": "^19.2.0",
    "moment": "^2.30.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.6",
    "@angular/cli": "^19.0.6",
    "@angular/compiler-cli": "^19.0.0",
    "@storybook/addon-docs": "^9.1.7",
    "@storybook/addon-onboarding": "^9.1.7",
    "@storybook/angular": "^9.1.7",
    "@storybook/jest": "^0.2.2",
    "@storybook/testing-library": "^0.2.1",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "angular-eslint": "20.3.0",
    "cypress": "^14.5.4",
    "eslint": "^9.35.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.6.1",
    "start-server-and-test": "^2.1.2",
    "storybook": "^9.1.7",
    "typescript": "~5.6.2",
    "typescript-eslint": "8.40.0"
  }
}
